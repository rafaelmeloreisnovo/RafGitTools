{
  "schema": "rafaelia.ecosystem-member/v1",
  "repository": "rafaelmeloreisnovo/RafGitTools",
  "authority": "federated-control-plane",
  "authority_sources": [
    "docs/federation/RAFAELIA_FEDERATED_OPERATIONS_V1.md",
