{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaelia.dev/schemas/ecosystem-runtime-map.v1.json",
  "title": "RAFAELIA Ecosystem Runtime Map v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "coordinator",
    "policy",
    "repositories",
    "external_dependencies",
    "capabilities",
    "edges",
    "summary"
  ],
  "properties": {
    "schema": {"const": "raf.ecosystem-runtime-map.v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "coordinator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branch"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "branch": {"type": "string", "minLength": 1}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_allowed",
        "unknown_is_success",
        "file_presence_is_runtime",
        "certified_without_external_evidence"
      ],
      "properties": {
        "claim_allowed": {"const": false},
        "unknown_is_success": {"const": false},
        "file_presence_is_runtime": {"const": false},
        "certified_without_external_evidence": {"const": false}
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "default_branch",
          "observed_ref",
          "repository_size_kib",
          "role",
          "state",
          "evidence",
          "gaps",
          "next_actions"
        ],
        "properties": {
          "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
          "default_branch": {"type": "string", "minLength": 1},
          "observed_ref": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
          "repository_size_kib": {"type": "integer", "minimum": 0},
          "role": {"type": "string", "minLength": 1},
          "state": {"enum": ["PASS", "PARTIAL", "DESIGN", "TOKEN_VAZIO", "BLOCKED", "QUARANTINE"]},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "gaps": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "next_actions": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "external_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "state", "reason"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "state": {"enum": ["PASS", "PARTIAL", "DESIGN", "TOKEN_VAZIO", "BLOCKED", "QUARANTINE", "REFERENCE"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "state", "repositories", "evidence", "gap", "gate"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{1,63}$"},
          "state": {"enum": ["PASS", "PARTIAL", "DESIGN", "TOKEN_VAZIO", "BLOCKED", "QUARANTINE"]},
          "repositories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "gap": {"type": "string", "minLength": 1},
          "gate": {"type": "string", "minLength": 1}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "contract", "state", "evidence", "gap"],
        "properties": {
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "contract": {"type": "string", "minLength": 1},
          "state": {"enum": ["PASS", "PARTIAL", "DESIGN", "TOKEN_VAZIO", "BLOCKED", "QUARANTINE"]},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "gap": {"type": "string", "minLength": 1}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositories_total", "repository_states", "capabilities_total", "capability_states"],
      "properties": {
        "repositories_total": {"type": "integer", "minimum": 1},
        "repository_states": {"$ref": "#/$defs/stateCounts"},
        "capabilities_total": {"type": "integer", "minimum": 1},
        "capability_states": {"$ref": "#/$defs/stateCounts"}
      }
    }
  },
  "$defs": {
    "stateCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "partial", "design", "token_vazio", "blocked", "quarantine"],
      "properties": {
        "pass": {"type": "integer", "minimum": 0},
        "partial": {"type": "integer", "minimum": 0},
        "design": {"type": "integer", "minimum": 0},
        "token_vazio": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0},
        "quarantine": {"type": "integer", "minimum": 0}
      }
    }
  }
}
