{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaelia.dev/schemas/runtime-gap-map.v1.json",
  "title": "RAFAELIA Runtime Gap Map v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "repository", "ref", "policy", "domains", "summary"],
  "properties": {
    "schema": {"const": "raf.runtime-gap-map.v1"},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "ref": {"type": "string", "minLength": 1},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_allowed", "certification_requires_evidence", "unknown_is_success"],
      "properties": {
        "claim_allowed": {"const": false},
        "certification_requires_evidence": {"const": true},
        "unknown_is_success": {"const": false}
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "domain", "state", "artifacts", "gaps", "next_actions", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3}$"},
          "domain": {"type": "string", "minLength": 1},
          "state": {
            "enum": ["PASS", "PARTIAL", "DESIGN", "TOKEN_VAZIO", "BLOCKED", "QUARANTINE"]
          },
          "artifacts": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "gaps": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "next_actions": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "path", "status"],
              "properties": {
                "kind": {"enum": ["SOURCE", "TEST", "LOG", "HASH", "RUNTIME", "CERTIFICATION", "REFERENCE"]},
                "path": {"type": "string", "minLength": 1},
                "status": {"enum": ["PRESENT", "PASS", "FAIL", "TOKEN_VAZIO", "EXTERNAL_REQUIRED"]}
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "partial", "design", "token_vazio", "blocked", "quarantine"],
      "properties": {
        "pass": {"type": "integer", "minimum": 0},
        "partial": {"type": "integer", "minimum": 0},
        "design": {"type": "integer", "minimum": 0},
        "token_vazio": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0},
        "quarantine": {"type": "integer", "minimum": 0}
      }
    }
  }
}
