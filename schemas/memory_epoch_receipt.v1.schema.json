{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaelia.local/schemas/memory_epoch_receipt.v1.schema.json",
  "title": "RAFAELIA Memory Epoch Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "producer",
    "artifact",
    "memory_epoch",
    "reset",
    "test_corpus",
    "policy",
    "observer",
    "cross_epoch_probe",
    "residual_state",
    "replay_binding",
    "decision",
    "claim_allowed"
  ],
  "properties": {
    "schema_id": {"const": "rafaelia.memory_epoch_receipt"},
    "schema_version": {"const": 1},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "commit", "adapter_id", "adapter_version"],
      "properties": {
        "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "adapter_id": {"type": "string", "minLength": 1},
        "adapter_version": {"type": "integer", "minimum": 1}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "memory_epoch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claimed_scope", "evidenced_scope"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "claimed_scope": {"$ref": "#/$defs/scope"},
        "evidenced_scope": {"$ref": "#/$defs/scope"}
      }
    },
    "reset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "evidence_refs"],
      "properties": {
        "class": {"$ref": "#/$defs/scope"},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "test_corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "observer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "independent", "runtime_can_modify_control_plane"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "independent": {"type": "boolean"},
        "runtime_can_modify_control_plane": {"type": "boolean"}
      }
    },
    "cross_epoch_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["marker_owner", "authorized_interface", "unexpected_correlation", "reproduced"],
      "properties": {
        "marker_owner": {"enum": ["EXTERNAL_OBSERVER"]},
        "authorized_interface": {"type": "boolean"},
        "unexpected_correlation": {"$ref": "#/$defs/tristate"},
        "reproduced": {"$ref": "#/$defs/tristate"}
      }
    },
    "residual_state": {"$ref": "#/$defs/tristate"},
    "replay_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_sha256", "epoch_id", "reset_class", "test_corpus_sha256", "policy_version"],
      "properties": {
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "epoch_id": {"type": "string", "minLength": 1},
        "reset_class": {"$ref": "#/$defs/scope"},
        "test_corpus_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "policy_version": {"type": "string", "minLength": 1}
      }
    },
    "decision": {"enum": ["PROMOTE", "QUARANTINE", "BLOCK"]},
    "claim_allowed": {"type": "boolean"}
  },
  "$defs": {
    "scope": {
      "enum": ["PROCESS", "RUNTIME", "CONTAINER", "VM", "EXTERNAL_MEMORY", "LEARNING_STATE", "HOST", "PHYSICAL_EPOCH"]
    },
    "tristate": {"enum": [true, false, "TOKEN_VAZIO"]}
  }
}
