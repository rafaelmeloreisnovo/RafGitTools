{
  "version": "1",
  "tools": {
    "git.status":             { "allowed": true,  "requires_auth": false, "handler_state": "IMPLEMENTED" },
    "git.diff":               { "allowed": true,  "requires_auth": false, "handler_state": "IMPLEMENTED" },
    "git.log":                { "allowed": true,  "requires_auth": false, "handler_state": "IMPLEMENTED" },
    "git.branch":             { "allowed": true,  "requires_auth": false, "handler_state": "IMPLEMENTED" },
    "git.push":               { "allowed": true,  "requires_auth": true,  "handler_state": "IMPLEMENTED_DURABLE_QUEUE" },
    "git.pull":               { "allowed": true,  "requires_auth": true,  "handler_state": "IMPLEMENTED_DURABLE_QUEUE" },
    "git.commit":             { "allowed": false, "requires_auth": true,  "handler_state": "WRITE_PROTECTED" },
    "git.commit.prepare":     { "allowed": false, "requires_auth": true,  "handler_state": "TOKEN_VAZIO_HANDLER_MISSING" },
    "github.repository.read": { "allowed": false, "requires_auth": true,  "handler_state": "TOKEN_VAZIO_HANDLER_MISSING" },
    "termux.health":          { "allowed": true,  "requires_auth": false, "handler_state": "IMPLEMENTED" },
    "rafpolimata.compile":    { "allowed": false, "requires_auth": true,  "handler_state": "TOKEN_VAZIO_HANDLER_MISSING" },
    "cti.search":             { "allowed": false, "requires_auth": false, "handler_state": "TOKEN_VAZIO_HANDLER_MISSING" }
  }
}
