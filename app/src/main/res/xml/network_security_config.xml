<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration

    Remote traffic remains HTTPS-only. Cleartext is permitted exclusively for
    the device loopback used by the local Kiwi/APK/model bridge.
-->
<network-security-config>
    <!-- Base configuration for all remote connections -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Local llamaRafaelia/llama.cpp runtime. Never broaden this to LAN hosts. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>

    <!-- GitHub API Configuration -->
    <domain-config>
        <domain includeSubdomains="true">github.com</domain>
        <domain includeSubdomains="true">api.github.com</domain>
    </domain-config>

    <!-- GitLab Configuration -->
    <domain-config>
        <domain includeSubdomains="true">gitlab.com</domain>
    </domain-config>

    <!-- Development Configuration (Debug builds only) -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
