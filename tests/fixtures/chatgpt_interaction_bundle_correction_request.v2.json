{
  "schema": "rafgittools.chatgpt-interaction-bundle-correction-request/v2",
  "explicit_target": {
    "repository": "owner/repo",
    "path": "src/module.py"
  },
  "exact_source_revision": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
  "deterministic_reproducer_or_falsifier": {
    "id": "F-001",
    "command": "python -m unittest tests.test_regression"
  },
  "root_cause_evidence": {
    "state": "REPRODUCED",
    "ref": "receipt:root-cause"
  },
  "bounded_patch": {
    "work_branch_only": true,
    "direct_main_write": false,
    "force_push": false,
    "remote_delete": false,
    "auto_merge": false,
    "auto_claim_promotion": false
  },
  "pre_patch_receipt": "receipt:pre",
  "rollback_condition": "revert bounded work-branch patch if falsifier or regression gate fails",
  "required_post_patch_tests": [
    "F-001",
    "regression-suite"
  ],
  "non_regression_invariants": [
    "SOURCE!=ARTIFACT!=EXECUTION!=EVIDENCE!=CLAIM",
    "IMPLEMENTED_UNTESTED!=PASS"
  ]
}
