{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rafaelia.execution_plan.v1",
  "title": "ExecutionPlan",
  "type": "object",
  "required": ["schema", "plan_id", "intent_id", "steps", "compiled"],
  "properties": {
    "schema": {"const": "rafaelia.execution_plan.v1"},
    "plan_id": {"type": "string", "minLength": 1},
    "intent_id": {"type": "string", "minLength": 1},
    "compiled": {"type": "boolean"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["command", "args", "read_only"],
        "properties": {
          "command": {"type": "string"},
          "args": {"type": "array", "items": {"type": "string"}},
          "read_only": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
