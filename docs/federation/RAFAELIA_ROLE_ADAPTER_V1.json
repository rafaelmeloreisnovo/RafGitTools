{
  "schema": "rafaelia.repository-role-adapter/v1",
  "schema_version": "1.0.0",
  "status": "DECLARATION_ONLY",
  "policy": {
    "append_only": true,
    "destructive_writes": false,
    "automatic_promotion": false,
    "claim_allowed": false
  },
  "federated_control_plane": {
    "repository": "rafaelmeloreisnovo/Mapa",
    "authority_matrix": {
      "path": "governance/AUTHORITY_MATRIX_V1.yaml",
      "ref": "b2a5d10fb3f386a69b26029cbc6d4355dc7ce0ed"
    },
    "role_contract": {
      "path": "contracts/vertical_slice_v1_repository_adapters.json",
      "ref": "b2a5d10fb3f386a69b26029cbc6d4355dc7ce0ed"
    }
  },
  "data_boundary": {
    "raw_private_content": "FORBIDDEN",
    "credentials_and_secrets": "FORBIDDEN",
    "permitted_inputs": [
      "descriptor-only records",
      "immutable source references",
      "hashes and checksums",
      "bounded metadata",
      "explicitly authorized test inputs"
    ],
    "deletion_move_share_or_publication": "NOT_AUTHORIZED_BY_THIS_ADAPTER"
  },
  "evidence_envelope": {
    "required_for_any_result": [
      "source locator",
      "immutable version",
      "method or command",
      "environment when executed",
      "output artifact or explicit absence",
      "checksum when bytes exist",
      "failure mode",
      "next verifiable step"
    ],
    "invariant": "SOURCE != IMPLEMENTATION != EXECUTION != EVIDENCE != CLAIM"
  },
  "claim_policy": {
    "claim_allowed": false,
    "no_automatic_promotion": true,
    "missing_evidence_state": "TOKEN_VAZIO",
    "ci_or_merge_is_not_execution_proof": true
  },
  "adapter_id": "adapter:rafgittools-control-plane-v1",
  "repository": {
    "full_name": "rafaelmeloreisnovo/RafGitTools",
    "default_branch": "main",
    "observed_base_commit": "9f4bf5747553cbdd4fcc77a6eb2ef7aead2c5bd8"
  },
  "role": "CONTROL_PLANE_AND_AUDIT",
  "input_contract": [
    "operational record V1",
    "descriptor-only source references",
    "explicit human scope"
  ],
  "output_contract": [
    "preflight",
    "route",
    "dry-run",
    "human authorization request"
  ],
  "authority_boundary": {
    "may_authorize": [
      "preflight",
      "routing",
      "dry_run",
      "human_authorization_request"
    ],
    "may_not_authorize": [
      "runtime_success",
      "scientific_validity",
      "production_readiness",
      "publication_claim"
    ]
  },
  "next_verifiable_step": "Accept one descriptor-only operational record, emit a dry-run that preserves all source pointers, and attach the resulting route without calling it an execution receipt."
}
