{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaelia.local/schemas/rafpolimata-custody-bridge-v1.schema.json",
  "title": "RafGitTools to RafPolimata Custody Bridge V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bridgeId",
    "producer",
    "consumer",
    "sourceRef",
    "artifactRef",
    "executionRef",
    "evidenceRefs",
    "state",
    "claimAllowed",
    "predecessorReceipt",
    "supersedesReceipt",
    "capabilityLabels",
    "observedAt"
  ],
  "properties": {
    "schemaVersion": {"const": "rafgittools.rafpolimata-custody-bridge.v1"},
    "bridgeId": {"type": "string", "minLength": 1},
    "producer": {"const": "rafaelmeloreisnovo/RafGitTools"},
    "consumer": {"const": "rafaelmeloreisnovo/RafPolimata"},
    "sourceRef": {"type": "string", "minLength": 1},
    "artifactRef": {"type": "string", "minLength": 1},
    "executionRef": {"type": "string", "minLength": 1},
    "evidenceRefs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "state": {
      "enum": ["PASS", "FAIL", "NOT_RUN", "PENDING", "AUDIT", "TOKEN_VAZIO", "IMPLEMENTED_UNTESTED", "OBSERVED_UNPROMOTED", "ROUTE_STATE_BLOCKED"]
    },
    "claimAllowed": {"const": false},
    "predecessorReceipt": {"type": "string", "minLength": 1},
    "supersedesReceipt": {"type": "string", "minLength": 1},
    "capabilityLabels": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][a-z0-9_]*$"}
    },
    "observedAt": {"type": "string", "minLength": 1}
  }
}
