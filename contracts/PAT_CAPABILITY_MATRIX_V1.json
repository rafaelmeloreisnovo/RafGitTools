{
  "schema": "rafgittools.pat-capability-matrix.v1",
  "version": "1.0.1",
  "authority": "rafaelmeloreisnovo/RafGitTools",
  "federated_authority": "rafaelmeloreisnovo/Mapa",
  "claim_allowed": false,
  "canonical_environment": "PAT_ENVIRONMENTS",
  "legacy_environment_case_alias": "Pat_environments",
  "secret_ids": [
    "PAT_ACTIONS",
    "PAT_AGENTS",
    "PAT_CODESPACES",
    "PAT_DEPENDABOT",
    "PAT_ENV",
    "PAT_ENVIRONMENTS"
  ],
  "invariants": [
    "SECRET_IDENTIFIER == UPPERCASE",
    "SECRET_VALUE_NEVER_PERSISTED_OR_PRINTED",
    "CAPABILITY != PERMISSION",
    "REGISTERED != WIRED",
    "WIRED != EXECUTED",
    "EXECUTED != PASS_WITHOUT_READBACK",
    "NO_PAT_FALLBACK",
    "PAT_ENV != PAT_ENVIRONMENTS",
    "HUMAN_REPORTED_CAPABILITY_REQUIRES_PROVIDER_READBACK_BEFORE_WIRING",
    "RafGitTools == PAT_BACKED_EXECUTOR",
    "Mapa == FEDERATED_ROUTING_AUTHORITY",
    "TOKEN_VAZIO != PASS",
    "PRIVATE_CI_PAT_SCOPE == ACCESS_STEPS_ONLY",
    "PRIVATE_CI_REPLAY_ENV != PAT_ENV",
    "PRIVATE_CI_PUBLIC_RECEIPT == HASH_ONLY"
  ],
  "capabilities": [
    {
      "secret_id": "PAT_ACTIONS",
      "storage_scope": "REPOSITORY_SECRET",
      "provider_surface": "GITHUB_ACTIONS_AND_CROSS_REPO_READ",
      "current_state": "WIRED_MAIN_ONESHOT_READ_ONLY",
      "wired_operations": [
        "preflight",
        "exact_commit_read_and_test",
        "exact_sha_private_checkout_read_only",
        "provider_actions_receipt",
        "private_ci_exact_sha_replay",
        "private_ci_hash_only_receipt"
      ],
      "candidate_operations": [
        "actions_run_read",
        "actions_job_read",
        "artifact_read"
      ],
      "provider_permission_hints": {
        "actions_read": "Actions:read",
        "private_repository_read": "repository access must include exact target"
      },
      "mutation_allowed": false,
      "permission_state": "PARTIAL_EVIDENCE_ONLY",
      "private_ci_lane_state": "IMPLEMENTED_UNTESTED",
      "secret_exposure_boundary": "ACCESS_AND_CHECKOUT_STEPS_ONLY"
    },
    {
      "secret_id": "PAT_AGENTS",
      "storage_scope": "REPOSITORY_SECRET",
      "provider_surface": "AGENT_ORCHESTRATION",
      "current_state": "REGISTERED_NOT_WIRED",
      "wired_operations": [
        "preflight"
      ],
      "candidate_operations": [
        "repository_read",
        "issue_pr_coordination",
        "workflow_dispatch"
      ],
      "provider_permission_hints": {
        "status": "TOKEN_VAZIO_UNSPECIFIED_ENDPOINT",
        "rule": "Do not infer a GitHub permission set until the exact agent operation/endpoint is selected."
      },
      "mutation_allowed": "TOKEN_VAZIO_PERMISSION_PROBE_REQUIRED",
      "permission_state": "TOKEN_VAZIO_NOT_PROBED"
    },
    {
      "secret_id": "PAT_CODESPACES",
      "storage_scope": "REPOSITORY_SECRET",
      "provider_surface": "GITHUB_CODESPACES",
      "current_state": "REGISTERED_NOT_WIRED",
      "wired_operations": [
        "preflight"
      ],
      "candidate_operations": [
        "codespace_list_read",
        "codespace_metadata_read",
        "codespace_lifecycle"
      ],
      "provider_permission_hints": {
        "read": "Codespaces:read",
        "create_or_mutate": "Codespaces:write"
      },
      "mutation_allowed": "TOKEN_VAZIO_PERMISSION_PROBE_REQUIRED",
      "permission_state": "TOKEN_VAZIO_NOT_PROBED"
    },
    {
      "secret_id": "PAT_DEPENDABOT",
      "storage_scope": "REPOSITORY_SECRET",
      "provider_surface": "GITHUB_DEPENDABOT",
      "current_state": "REGISTERED_NOT_WIRED",
      "wired_operations": [
        "preflight"
      ],
      "candidate_operations": [
        "dependabot_alert_read",
        "dependabot_alert_update",
        "dependabot_provider_operations"
      ],
      "provider_permission_hints": {
        "read": "Dependabot alerts:read",
        "update_alert": "Dependabot alerts:write"
      },
      "mutation_allowed": "TOKEN_VAZIO_PERMISSION_PROBE_REQUIRED",
      "permission_state": "TOKEN_VAZIO_NOT_PROBED"
    },
    {
      "secret_id": "PAT_ENV",
      "storage_scope": "ENVIRONMENT_SECRET",
      "provider_surface": "GITHUB_ENVIRONMENTS_AND_MAIN_PROTECTION",
      "environment": "PAT_ENVIRONMENTS",
      "current_state": "WIRED_MANUAL_ONLY",
      "wired_operations": [
        "preflight",
        "apply_main_protection",
        "rollback_main_protection"
      ],
      "candidate_operations": [
        "environment_readback",
        "environment_policy_mutation",
        "branch_protection_read",
        "branch_protection_mutation"
      ],
      "provider_permission_hints": {
        "list_environments": "Actions:read",
        "environment_mutation": "Administration:write",
        "branch_protection_read": "Administration:read",
        "branch_protection_mutation": "Administration:write"
      },
      "mutation_allowed": "MANUAL_GATED_ONLY",
      "permission_state": "BOUNDED_BY_EXISTING_PROVIDER_ROUTE"
    },
    {
      "secret_id": "PAT_ENVIRONMENTS",
      "storage_scope": "TOKEN_VAZIO_PROVIDER_SCOPE_PENDING",
      "provider_surface": "HUMAN_REPORTED_DISTINCT_PAT_IDENTITY",
      "environment": "TOKEN_VAZIO_PROVIDER_BINDING_PENDING",
      "current_state": "HUMAN_REPORTED_PROVIDER_READBACK_PENDING",
      "wired_operations": [],
      "candidate_operations": [],
      "provider_permission_hints": {
        "status": "TOKEN_VAZIO_PROVIDER_READBACK_REQUIRED",
        "rule": "Do not infer repository-vs-environment storage, binding, permission or endpoint from the identifier alone."
      },
      "mutation_allowed": false,
      "permission_state": "TOKEN_VAZIO_NOT_PROVIDER_READBACK"
    }
  ],
  "routing": {
    "executor": "rafaelmeloreisnovo/RafGitTools",
    "federated_index": "rafaelmeloreisnovo/Mapa",
    "rule": "All PAT-backed operations execute through bounded RafGitTools lanes; Mapa stores typed capability/routing metadata and evidence pointers, never secret values."
  }
}
