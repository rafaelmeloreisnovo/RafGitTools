{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafgittools.local/contracts/rafgitfs-storage-profile-v1.schema.json",
  "title": "RafGitFS Storage Profile V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "display_name",
    "provider",
    "scope",
    "scope_value",
    "default_ref",
    "access_mode",
    "cache_policy",
    "write_policy",
    "protected_branch_patterns",
    "receipt_required",
    "claim_allowed",
    "enabled"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "profile_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "provider": { "const": "GITHUB" },
    "scope": {
      "enum": ["AUTHENTICATED_USER", "ORGANIZATION", "SELECTED_REPOSITORIES"]
    },
    "scope_value": { "type": "string", "minLength": 1, "maxLength": 100 },
    "selected_repositories": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
      "default": []
    },
    "default_ref": { "type": "string", "minLength": 1, "maxLength": 255 },
    "access_mode": { "enum": ["READ_ONLY", "GOVERNED_WORKSPACE"] },
    "cache_policy": { "enum": ["METADATA_ONLY", "ON_DEMAND", "SELECTIVE_OFFLINE"] },
    "write_policy": { "enum": ["BLOCKED", "BRANCH_AND_PULL_REQUEST", "DIRECT_COMMIT"] },
    "protected_branch_patterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 255 }
    },
    "receipt_required": { "const": true },
    "claim_allowed": { "const": false },
    "enabled": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "scope": { "const": "SELECTED_REPOSITORIES" } } },
      "then": { "properties": { "selected_repositories": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "access_mode": { "const": "READ_ONLY" } } },
      "then": { "properties": { "write_policy": { "const": "BLOCKED" } } }
    }
  ]
}
