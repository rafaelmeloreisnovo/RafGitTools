{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RafGitTools Private Processing Seed V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "seed_id",
    "observed_at",
    "architecture",
    "source",
    "artifact",
    "execution",
    "evidence",
    "claim",
    "gaps",
    "next"
  ],
  "properties": {
    "schema": {
      "const": "rafgittools.private-processing-seed/v1"
    },
    "seed_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "minLength": 1
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "capability_ref",
        "route"
      ],
      "properties": {
        "state": {
          "enum": [
            "DETERMINED",
            "PARTIAL",
            "TOKEN_VAZIO"
          ]
        },
        "capability_ref": {
          "type": "string",
          "minLength": 1
        },
        "route": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "authority_alias",
        "state",
        "sha256",
        "raw_mutated"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "authority_alias": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "DETERMINED",
            "PARTIAL",
            "TOKEN_VAZIO"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^(TOKEN_VAZIO|[0-9a-f]{64})$"
        },
        "raw_mutated": {
          "const": false
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "state",
        "destination_alias",
        "output_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "TOKEN_VAZIO",
            "NOT_RUN",
            "PENDING",
            "IMPLEMENTED_UNTESTED",
            "PASS",
            "FAIL"
          ]
        },
        "destination_alias": {
          "type": "string",
          "minLength": 1
        },
        "output_sha256": {
          "type": "string",
          "pattern": "^(TOKEN_VAZIO|[0-9a-f]{64})$"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "execution_id",
        "device_ref",
        "processor_ref",
        "processor_sha256"
      ],
      "properties": {
        "state": {
          "enum": [
            "TOKEN_VAZIO",
            "NOT_RUN",
            "PENDING",
            "IMPLEMENTED_UNTESTED",
            "PASS",
            "FAIL",
            "AUDIT"
          ]
        },
        "execution_id": {
          "type": "string",
          "minLength": 1
        },
        "device_ref": {
          "type": "string",
          "minLength": 1
        },
        "processor_ref": {
          "type": "string",
          "minLength": 1
        },
        "processor_sha256": {
          "type": "string",
          "pattern": "^(TOKEN_VAZIO|[0-9a-f]{64})$"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "receipt_id",
        "receipt_sha256"
      ],
      "properties": {
        "state": {
          "enum": [
            "TOKEN_VAZIO",
            "NOT_RUN",
            "PENDING",
            "PASS",
            "FAIL",
            "AUDIT",
            "OBSERVED_UNPROMOTED"
          ]
        },
        "receipt_id": {
          "type": "string",
          "minLength": 1
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^(TOKEN_VAZIO|[0-9a-f]{64})$"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "claim_allowed",
        "reason"
      ],
      "properties": {
        "state": {
          "enum": [
            "BLOCKED",
            "PENDING",
            "ALLOWED"
          ]
        },
        "claim_allowed": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "field",
          "state",
          "reason",
          "promotion_condition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "TOKEN_VAZIO",
              "PENDING",
              "AUDIT",
              "NOT_RUN",
              "FAIL"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "promotion_condition": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "next": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "gate"
      ],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "gate": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "claim": {
            "properties": {
              "claim_allowed": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "architecture": {
            "properties": {
              "state": {
                "const": "DETERMINED"
              }
            }
          },
          "source": {
            "properties": {
              "sha256": {
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "artifact": {
            "properties": {
              "state": {
                "const": "PASS"
              },
              "output_sha256": {
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "execution": {
            "properties": {
              "state": {
                "const": "PASS"
              },
              "execution_id": {
                "not": {
                  "const": "TOKEN_VAZIO"
                }
              },
              "device_ref": {
                "not": {
                  "const": "TOKEN_VAZIO"
                }
              },
              "processor_sha256": {
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "evidence": {
            "properties": {
              "state": {
                "const": "PASS"
              },
              "receipt_id": {
                "not": {
                  "const": "TOKEN_VAZIO"
                }
              },
              "receipt_sha256": {
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "claim": {
            "properties": {
              "state": {
                "const": "ALLOWED"
              }
            }
          }
        }
      }
    }
  ]
}
